--// CAMBIAR TARGET ORIGINAL
local function ChangeTargetPart()

	Config.TargetPartIndex += 1

	if Config.TargetPartIndex >
		#Config.TargetParts then

		Config.TargetPartIndex = 1
	end

	Config.TargetPart =
		Config.TargetParts[
			Config.TargetPartIndex
		]

	if Config.TargetPart ==
		"UpperTorso" then

		local Character =
			LocalPlayer.Character

		if Character
			and not Character:FindFirstChild(
				"UpperTorso"
			) then

			Config.TargetPart = "Torso"
		end
	end

	UpdateStatus()

	print(
		"3VEXXCRYPT | Target:",
		Config.TargetPart
	)
end

