--==================================================
-- ESP STORAGE
--==================================================

local ESPObjects = {}

local LineObjects = {}

--==================================================
-- REMOVE ESP
--==================================================

local function RemoveESP(object)

    if ESPObjects[object] then

        ESPObjects[object]:Destroy()

        ESPObjects[object] = nil

    end

end

--==================================================
-- CREATE ESP
--==================================================

local function CreateESP(object, text)

    if ESPObjects[object] then
        return
    end

    local adornee

    if object:IsA("BasePart") then

        adornee = object

    elseif object:IsA("Model") then

        adornee =
            object:FindFirstChildWhichIsA(
                "BasePart",
                true
            )

    end

    if not adornee then
        return
    end

    local Billboard =
        Instance.new("BillboardGui")

    Billboard.Name =
        "3VEXXCRYPT_ESP"

    Billboard.Size =
        UDim2.new(0, 180, 0, 35)

    Billboard.StudsOffset =
        Vector3.new(0, 2, 0)

    Billboard.AlwaysOnTop = true

    Billboard.Adornee = adornee

    Billboard.Parent = adornee

    local Label =
        Instance.new("TextLabel")

    Label.Size =
        UDim2.new(1, 0, 1, 0)

    Label.BackgroundTransparency = 1

    Label.Text = text

    Label.TextColor3 =
        Color3.new(1, 1, 1)

    Label.TextStrokeTransparency = 0

    Label.TextSize = 14

    Label.Font =
        Enum.Font.GothamBold

    Label.Parent = Billboard

    ESPObjects[object] = Billboard

end

--==================================================
-- LINE ESP
--==================================================

local function CreateLine(player)

    if LineObjects[player] then
        return
    end

    local Line =
        Drawing.new("Line")

    Line.Thickness = 1.5
    Line.Transparency = 1
    Line.Visible = false

    LineObjects[player] = Line

end

local function RemoveLine(player)

    if LineObjects[player] then

        LineObjects[player]:Remove()

        LineObjects[player] = nil

    end

end

local function UpdateLines()

    for _, player in ipairs(Players:GetPlayers()) do

        if player ~= LocalPlayer then

            if Config.PlayerESP.Line then

                CreateLine(player)

                local Line =
                    LineObjects[player]

                local Character =
                    player.Character

                local Root =
                    Character
                    and Character:FindFirstChild(
                        "HumanoidRootPart"
                    )

                if Root then

                    local Position, Visible =
                        Camera:WorldToViewportPoint(
                            Root.Position
                        )

                    if Visible then

                        local Viewport =
                            Camera.ViewportSize

                        Line.From =
                            Vector2.new(
                                Viewport.X / 2,
                                Viewport.Y
                            )

                        Line.To =
                            Vector2.new(
                                Position.X,
                                Position.Y
                            )

                        Line.Visible = true

                    else

                        Line.Visible = false

                    end

                else

                    Line.Visible = false

                end

            elseif LineObjects[player] then

                RemoveLine(player)

            end

        end

    end

end

--==================================================
-- WEAPON SCANNER
--==================================================

local function ScanWeapons()

    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        if Weapons[object.Name] then

            if Config.WeaponESP.Enabled then

                CreateESP(
                    object,
                    "🔫 " .. object.Name
                )

            else

                RemoveESP(object)

            end

        end

    end

end

--==================================================
-- PLAYER ESP
--==================================================

local function UpdatePlayerESP()

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then

            local character =
                player.Character

            if character
                and Config.PlayerESP.Enabled then

                local target

                if Config.PlayerESP.Head then

                    target =
                        character:FindFirstChild(
                            "Head"
                        )

                elseif Config.PlayerESP.Chest then

                    target =
                        character:FindFirstChild(
                            "UpperTorso"
                        )
                        or
                        character:FindFirstChild(
                            "Torso"
                        )

                elseif Config.PlayerESP.Torso then

                    target =
                        character:FindFirstChild(
                            "Torso"
                        )

                end

                if target then

                    local distance = 0

                    if LocalPlayer.Character then

                        local root1 =
                            LocalPlayer.Character:
                            FindFirstChild(
                                "HumanoidRootPart"
                            )

                        local root2 =
                            character:
                            FindFirstChild(
                                "HumanoidRootPart"
                            )

                        if root1 and root2 then

                            distance =
                                math.floor(
                                    (
                                        root1.Position
                                        -
                                        root2.Position
                                    ).Magnitude
                                )

                        end

                    end

                    local text = ""

                    if Config.PlayerESP.Name then

                        text =
                            player.Name

                    end

                    if Config.PlayerESP.Distance then

                        if text ~= "" then

                            text =
                                text
                                ..
                                " ["
                                ..
                                distance
                                ..
                                "m]"

                        else

                            text =
                                "["
                                ..
                                distance
                                ..
                                "m]"

                        end

                    end

                    CreateESP(
                        target,
                        text
                    )

                end

            end

        end

    end

end

--==================================================
-- AIM ASSIST
--==================================================

local function GetClosestPlayer()

    local closest = nil

    local closestDistance =
        Config.Aimbot.FOV

    local mousePosition =
        UserInputService:GetMouseLocation()

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then

            local character =
                player.Character

            if character then

                local part =
                    character:FindFirstChild(
                        Config.Aimbot.TargetPart
                    )

                if part then

                    local screenPosition,
                        visible =
                        Camera:WorldToViewportPoint(
                            part.Position
                        )

                    if visible then

                        local distance =
                            (
                                Vector2.new(
                                    screenPosition.X,
                                    screenPosition.Y
                                )
                                -
                                mousePosition
                            ).Magnitude

                        if distance <
                            closestDistance then

                            closestDistance =
                                distance

                            closest = part

                        end

                    end

                end

            end

        end

    end

    return closest

end

--==================================================
-- MAIN LOOP
--==================================================

RunService.RenderStepped:Connect(
    function()

        -- AIM

        if Config.Aimbot.Enabled then

            local target =
                GetClosestPlayer()

            if target then

                local cameraPosition =
                    Camera.CFrame.Position

                local desired =
                    CFrame.lookAt(
                        cameraPosition,
                        target.Position
                    )

                Camera.CFrame =
                    Camera.CFrame:Lerp(
                        desired,
                        Config.Aimbot.Smoothness
                    )

            end

        end

        -- PLAYER ESP

        UpdatePlayerESP()

        -- LINE ESP

        UpdateLines()

        -- WEAPON ESP

        ScanWeapons()

    end
)

