local function IsOtherPlayerCharacter(Character)
	if not Character or not Character:IsA("Model") then
		return false
	end

	local Player =
		Players:GetPlayerFromCharacter(Character)

	return Player ~= nil
		and Player ~= LocalPlayer
end

local function IsEquippedWeapon(Object)
	if not Object:IsA("Tool") then
		return false
	end

	local Character = Object.Parent

	if not IsOtherPlayerCharacter(Character) then
		return false
	end

	return true
end

local function CreateWeaponESP(Object)
	if not Config.WeaponESPEnabled then
		return
	end

	if not IsEquippedWeapon(Object) then
		return
	end

	if WeaponESPObjects[Object] then
