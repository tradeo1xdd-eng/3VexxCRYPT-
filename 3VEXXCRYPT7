	"spawn",
	"purchasepoint",
	"buyzone"
}

local function ShouldSkip(Object)
	if not Object then
		return true
	end

	local Name = string.lower(Object.Name)

	for _, Word in ipairs(SkipWords) do
		if string.find(Name, Word, 1, true) then
			return true
		end
	end

	return false
end

local function IsPlayerCharacterObject(Object)
	for _, Player in ipairs(Players:GetPlayers()) do
		local Character = Player.Character

		if Character and Object:IsDescendantOf(Character) then
			return true
		end
	end

	return false
end

