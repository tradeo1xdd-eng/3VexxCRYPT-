local LineESP = {}

local function RemoveLineESP(Player)
	if LineESP[Player] then
		LineESP[Player]:Destroy()
		LineESP[Player] = nil
	end
end

local function CreateLineESP(Player)
	if Player == LocalPlayer then
		return
	end

	local Line = Instance.new("Frame")

	Line.Name = "3VEXXCRYPT_Line"
	Line.AnchorPoint = Vector2.new(0.5,0.5)
	Line.BackgroundColor3 = Color3.new(1,1,1)
	Line.BorderSizePixel = 0
	Line.Size = UDim2.new(0,1,0,0)
	Line.Visible = false
	Line.Parent = ScreenGui

	LineESP[Player] = Line
end

local function UpdateLineESP()
	for Player,Line in pairs(LineESP) do
		if not Config.LineESPEnabled then
			Line.Visible = false
			continue
		end

		local Character = Player.Character
		local Root = Character and Character:FindFirstChild("HumanoidRootPart")

		if not Root then
			Line.Visible = false
			continue
		end

		local ScreenPos,OnScreen =
			Camera:WorldToViewportPoint(Root.Position)

		if not OnScreen then
			Line.Visible = false
			continue
		end

		local Start =
			Vector2.new(
				Camera.ViewportSize.X/2,
				Camera.ViewportSize.Y
			)

		local Finish =
			Vector2.new(
				ScreenPos.X,
				ScreenPos.Y
			)

		local Difference = Finish - Start
		local Length = Difference.Magnitude

		Line.Position =
			UDim2.new(
				0,
				Start.X + Difference.X/2,
				0,
				Start.Y + Difference.Y/2
			)

		Line.Size =
			UDim2.new(0,1,0,Length)

		Line.Rotation =
			math.deg(math.atan2(Difference.Y,Difference.X))
			+ 90

		Line.Visible = true
	end
end

