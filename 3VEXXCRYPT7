local function NextTarget()
	Config.TargetPartIndex += 1

	if Config.TargetPartIndex >
		#Config.TargetParts then

		Config.TargetPartIndex = 1
	end

	Config.TargetPart =
		Config.TargetParts[
			Config.TargetPartIndex
		]

	TargetButton.Text =
		"Objetivo: " ..
		GetTargetDisplayName()

	Status.Text =
		"3VEXXCRYPT | " ..
		GetTargetDisplayName()
end

