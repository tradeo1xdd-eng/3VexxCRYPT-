local ItemESPObjects = {}

local function RemoveItemESP(Object)
	local Data = ItemESPObjects[Object]

	if not Data then
		return
	end

	if Data.Highlight then
		Data.Highlight:Destroy()
	end

	if Data.Billboard then
		Data.Billboard:Destroy()
	end

	ItemESPObjects[Object] = nil
end

local function FindItemImage(Object)
	local TextureId =
		Object:GetAttribute("TextureId")
		or Object:GetAttribute("TextureID")
		or Object:GetAttribute("ImageId")
		or Object:GetAttribute("ImageID")

	if TextureId then
		return tostring(TextureId)
	end

	for _, Descendant in ipairs(Object:GetDescendants()) do
		if Descendant:IsA("Decal")
			or Descendant:IsA("Texture") then

			if Descendant.Texture ~= "" then
				return Descendant.Texture
			end
		end

		if Descendant:IsA("ImageLabel")
			or Descendant:IsA("ImageButton") then

			if Descendant.Image ~= "" then
				return Descendant.Image
			end
		end
	end

	return nil
end

local function CreateItemESP(Object)
	if not Config.ItemESPEnabled then
		return
	end

	if not Object:IsA("Model")
		and not Object:IsA("BasePart") then
		return
	end

	-- No meter partes individuales dentro de un Model.
	if Object:IsA("BasePart")
		and Object.Parent
		and Object.Parent:IsA("Model") then
		return
	end

	-- Nunca Item ESP sobre jugadores.
	if IsPlayerCharacterObject(Object) then
		return
	end

	-- Filtros.
	if ShouldSkip(Object) then
		return
	end

	-- Tools no son Item ESP.
	if Object:IsA("Tool") then
		return
	end

	if ItemESPObjects[Object] then
		return
	end

	local Adornee

	if Object:IsA("Model") then
		Adornee =
			Object.PrimaryPart
			or Object:FindFirstChildWhichIsA("BasePart", true)
	else
		Adornee = Object
	end

	if not Adornee then
		return
	end

	local Highlight = Instance.new("Highlight")
	Highlight.Name = "3VEXXCRYPT_ItemESP"
	Highlight.FillTransparency = 0.85
	Highlight.OutlineTransparency = 0
	Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	Highlight.Adornee = Object
	Highlight.Parent = Object

	local Billboard = Instance.new("BillboardGui")
	Billboard.Name = "3VEXXCRYPT_ItemInfo"
	Billboard.Size = UDim2.new(0, 150, 0, 45)
	Billboard.StudsOffset = Vector3.new(0, 2.5, 0)
	Billboard.AlwaysOnTop = true
	Billboard.MaxDistance = Config.MaxDistance
	Billboard.Adornee = Adornee
	Billboard.Parent = Object

	local Image = Instance.new("ImageLabel")
	Image.Size = UDim2.new(0, 30, 0, 30)
	Image.Position = UDim2.new(0, 0, 0.5, -15)
	Image.BackgroundTransparency = 1
	Image.Visible = false
	Image.Parent = Billboard

	local Text = Instance.new("TextLabel")
	Text.Size = UDim2.new(1, -35, 1, 0)
	Text.Position = UDim2.new(0, 35, 0, 0)
	Text.BackgroundTransparency = 1
	Text.TextColor3 = Color3.new(1, 1, 1)
	Text.TextStrokeTransparency = 0.5
	Text.TextSize = 8
	Text.Font = Enum.Font.GothamBold
	Text.TextXAlignment = Enum.TextXAlignment.Left
	Text.Parent = Billboard

	if Config.ItemESPImages then
		local ImageId = FindItemImage(Object)

		if ImageId then
			Image.Image = ImageId
			Image.Visible = true
		end
	end

	ItemESPObjects[Object] = {
		Highlight = Highlight,
		Billboard = Billboard,
		Text = Text,
		Image = Image,
		Adornee = Adornee
	}
end

local function UpdateItemESP()
	if not Config.ItemESPEnabled then
		for _, Data in pairs(ItemESPObjects) do
			Data.Highlight.Enabled = false
			Data.Billboard.Enabled = false
		end

		return
	end

	for Object, Data in pairs(ItemESPObjects) do
		if not Object.Parent then
			RemoveItemESP(Object)
			continue
		end

		if IsPlayerCharacterObject(Object) then
			RemoveItemESP(Object)
			continue
		end

		local Adornee = Data.Adornee

		if not Adornee or not Adornee.Parent then
			RemoveItemESP(Object)
			continue
		end

		local Distance =
			(Adornee.Position - Camera.CFrame.Position).Magnitude

		if Distance > Config.MaxDistance then
			Data.Highlight.Enabled = false
			Data.Billboard.Enabled = false
			continue
		end

		local Text = ""

		if Config.ItemESPNames then
			Text = Object.Name
		end

		if Config.ItemESPDistance then
			if Text ~= "" then
				Text = Text .. " [" .. math.floor(Distance) .. "m]"
			else
				Text = "[" .. math.floor(Distance) .. "m]"
			end
		end

		Data.Text.Text = Text
		Data.Highlight.Enabled = true
		Data.Billboard.Enabled = true
	end
end

-- Solo registrar objetos cuando aparecen.
workspace.DescendantAdded:Connect(function(Object)
