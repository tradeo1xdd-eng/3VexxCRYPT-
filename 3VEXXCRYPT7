local ItemESP = {}

local function GetAdornee(Object)
	if Object:IsA("BasePart") then
		return Object
	end

	if Object:IsA("Model") then
		return Object.PrimaryPart
			or Object:FindFirstChildWhichIsA("BasePart",true)
	end

	return nil
end

local function RemoveItemESP(Object)
	local Data = ItemESP[Object]

	if not Data then
		return
	end

	if Data.Highlight then
		Data.Highlight:Destroy()
	end

	if Data.Billboard then
		Data.Billboard:Destroy()
	end

	ItemESP[Object] = nil
end

local function CreateItemESP(Object)
	if not Object then
		return
	end

	if not Object:IsA("Model")
		and not Object:IsA("BasePart") then
		return
	end

	if ShouldSkip(Object) then
		return
	end

	if LocalPlayer.Character
		and Object:IsDescendantOf(LocalPlayer.Character) then
		return
	end

	if ItemESP[Object] then
		return
	end

	local Adornee = GetAdornee(Object)

	if not Adornee then
		return
	end

	local Highlight = Instance.new("Highlight")
	Highlight.Name = "3VEXXCRYPT_ItemESP"
	Highlight.FillTransparency = 0.85
	Highlight.OutlineTransparency = 0
	Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	Highlight.Adornee = Object
	Highlight.Parent = Object

	local Billboard = Instance.new("BillboardGui")
	Billboard.Name = "3VEXXCRYPT_ItemInfo"
	Billboard.Size = UDim2.new(0,150,0,24)
	Billboard.StudsOffset = Vector3.new(0,2.5,0)
	Billboard.AlwaysOnTop = true
	Billboard.Adornee = Adornee
	Billboard.Parent = Object

	local Text = Instance.new("TextLabel")
	Text.Size = UDim2.new(1,0,1,0)
	Text.BackgroundTransparency = 1
	Text.TextColor3 = Color3.new(1,1,1)
	Text.TextStrokeTransparency = 0.5
	Text.TextSize = 8
	Text.Font = Enum.Font.GothamBold
	Text.Parent = Billboard

	ItemESP[Object] = {
		Highlight = Highlight,
		Billboard = Billboard,
		Text = Text,
		Adornee = Adornee
	}
end

local function UpdateItemESP()
	for Object,Data in pairs(ItemESP) do
		if not Object.Parent then
			RemoveItemESP(Object)
			continue
		end

		if not Config.ItemESPEnabled then
			Data.Highlight.Enabled = false
			Data.Billboard.Enabled = false
			continue
		end

		local Adornee = Data.Adornee

		if not Adornee or not Adornee.Parent then
			RemoveItemESP(Object)
			continue
		end

		local Distance =
			(Adornee.Position - Camera.CFrame.Position).Magnitude

		local Text = ""

		if Config.ItemESPNames then
			Text = Object.Name
		end

		if Config.ItemESPDistance then
			if Text ~= "" then
				Text = Text.." ["..math.floor(Distance).."m]"
			else
				Text = "["..math.floor(Distance).."m]"
			end
		end

		Data.Text.Text = Text
		Data.Highlight.Enabled = true
		Data.Billboard.Enabled = true
	end
end

