local PlayerESP = {}

local function RemovePlayerESP(Player)
	local Data = PlayerESP[Player]

	if not Data then
		return
	end

	if Data.Highlight then
		Data.Highlight:Destroy()
	end

	if Data.Billboard then
		Data.Billboard:Destroy()
	end

	if Data.Line then
		Data.Line:Destroy()
	end

	PlayerESP[Player] = nil
end

local function CreatePlayerESP(Player)
	if Player == LocalPlayer then
		return
	end

	local Character = Player.Character

	if not Character then
		return
	end

	local Root = Character:FindFirstChild("HumanoidRootPart")

	if not Root then
		return
	end

	RemovePlayerESP(Player)

	local Highlight = Instance.new("Highlight")
	Highlight.Name = "3VEXXCRYPT_PlayerESP"
	Highlight.FillTransparency = 0.8
	Highlight.OutlineTransparency = 0
	Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	Highlight.Adornee = Character
	Highlight.Parent = Character

	local Billboard = Instance.new("BillboardGui")
	Billboard.Name = "3VEXXCRYPT_PlayerInfo"
	Billboard.Size = UDim2.new(0,150,0,25)
	Billboard.StudsOffset = Vector3.new(0,3,0)
	Billboard.AlwaysOnTop = true
	Billboard.Adornee = Root
	Billboard.Parent = Character

	local Text = Instance.new("TextLabel")
	Text.Size = UDim2.new(1,0,1,0)
	Text.BackgroundTransparency = 1
	Text.TextColor3 = Color3.new(1,1,1)
	Text.TextStrokeTransparency = 0.5
	Text.TextSize = 9
	Text.Font = Enum.Font.GothamBold
	Text.Parent = Billboard

	PlayerESP[Player] = {
		Highlight = Highlight,
		Billboard = Billboard,
		Text = Text
	}
end

local function UpdatePlayerESP()
	for Player,Data in pairs(PlayerESP) do
		local Character = Player.Character

		if not Character or not Character.Parent then
			RemovePlayerESP(Player)
			continue
		end

		local Root = Character:FindFirstChild("HumanoidRootPart")
		local Humanoid = Character:FindFirstChildOfClass("Humanoid")

		if not Root or not Humanoid or Humanoid.Health <= 0 then
			Data.Highlight.Enabled = false
			Data.Billboard.Enabled = false
			continue
		end

		if not Config.ESPEnabled then
			Data.Highlight.Enabled = false
			Data.Billboard.Enabled = false
			continue
		end

		local Distance =
			(Root.Position - Camera.CFrame.Position).Magnitude

		local Text = ""

		if Config.ESPNames then
			Text = Player.Name
		end

		if Config.ESPDistance then
			if Text ~= "" then
				Text = Text.." ["..math.floor(Distance).."m]"
			else
				Text = "["..math.floor(Distance).."m]"
			end
		end

		Data.Text.Text = Text
		Data.Highlight.Enabled = true
		Data.Billboard.Enabled = true
	end
end

