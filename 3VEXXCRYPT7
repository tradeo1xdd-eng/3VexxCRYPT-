	"spawn",
	"purchasepoint",
	"buyzone"
}

local function ShouldSkip(Object)
	if not Object then
		return true
	end

	local Name = string.lower(Object.Name)

	for _, Word in ipairs(SkipWords) do
		if string.find(Name, Word, 1, true) then
			return true
		end
	end

	return false
end

