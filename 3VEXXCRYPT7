local function CreateWeaponESP(Object)
	if not Object:IsA("Tool") then
		return
	end

	if WeaponESP[Object] then
		return
	end

	local Character = Object.Parent

	if not Character
		or not Character:IsA("Model")
		or not Players:GetPlayerFromCharacter(Character) then
		return
	end

	local Handle =
		Object:FindFirstChild("Handle")
		or Object:FindFirstChildWhichIsA("BasePart",true)

	if not Handle then
		return
	end

	local Highlight = Instance.new("Highlight")
	Highlight.Name = "3VEXXCRYPT_WeaponESP"
	Highlight.FillTransparency = 0.8
	Highlight.OutlineTransparency = 0
	Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	Highlight.Adornee = Object
	Highlight.Parent = Object

	local Billboard = Instance.new("BillboardGui")
	Billboard.Name = "3VEXXCRYPT_WeaponInfo"
	Billboard.Size = UDim2.new(0,140,0,22)
	Billboard.StudsOffset = Vector3.new(0,2,0)
	Billboard.AlwaysOnTop = true
	Billboard.Adornee = Handle
	Billboard.Parent = Object

	local Text = Instance.new("TextLabel")
	Text.Size = UDim2.new(1,0,1,0)
	Text.BackgroundTransparency = 1
	Text.TextColor3 = Color3.new(1,1,1)
	Text.TextStrokeTransparency = 0.5
	Text.TextSize = 8
	Text.Font = Enum.Font.GothamBold
	Text.Text = Object.Name
	Text.Parent = Billboard

	WeaponESP[Object] = {
		Highlight = Highlight,
		Billboard = Billboard,
		Text = Text,
		Handle = Handle
	}
end

local function UpdateWeaponESP()
	for Object,Data in pairs(WeaponESP) do
		if not Object.Parent then
			RemoveWeaponESP(Object)
			continue
		end

		local Character = Object.Parent
		local IsEquipped =
			Character
			and Character:IsA("Model")
			and Players:GetPlayerFromCharacter(Character)

		if not Config.WeaponESPEnabled or not IsEquipped then
			Data.Highlight.Enabled = false
			Data.Billboard.Enabled = false
			continue
		end

		local Handle = Data.Handle

		if not Handle or not Handle.Parent then
			Data.Highlight.Enabled = false
			Data.Billboard.Enabled = false
			continue
		end

		local Distance =
			(Handle.Position - Camera.CFrame.Position).Magnitude

		Data.Text.Text =
			Object.Name.." ["..math.floor(Distance).."m]"

		Data.Highlight.Enabled = true
		Data.Billboard.Enabled = true
	end
end

workspace.DescendantAdded:Connect(function(Object)
	if Object:IsA("Tool") then
		task.defer(function()
